{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/src/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/web/assets/$1"
    },
    {
      "src": "/logo.png",
      "dest": "/web/logo.png"
    },
    {
      "src": "/vite.svg",
      "dest": "/web/vite.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/web/index.html"
    }
  ]
}
